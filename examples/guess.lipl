// Guess the number: the computer thinks of a number from 1 to 100, and says
// whether each guess is too high or too low.
//
// LIPL has no random numbers, so the secret is made from a word you type.
// Each character is stirred into a seed with the same arithmetic C's rand()
// has traditionally used. The same word always gives the same secret, which
// is also what lets the tests play this game with fixed guesses.

const var characters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";

// where `c` first appears in `text`, or -1
func find(text, c) {
    for var i = 0; i < len(text); i = i + 1 {
        if text[i] == c {
            return i;
        }
    }
    return -1;
}

// one step of a linear congruential generator
func next_seed(seed) {
    return (seed * 1103515245 + 12345) % 2147483648;
}

func pick_secret(word) {
    var seed = 1;
    for var i = 0; i < len(word); i = i + 1 {
        seed = next_seed(seed + find(characters, word[i]) + 1);
    }
    // the low bits of this generator repeat quickly, so use the higher ones
    return seed / 65536 % 100 + 1;
}

// "42" is a guess; "forty-two", "" and "4 2" aren't. Checking first matters:
// int() on something that isn't a number stops the program.
func is_guess(text) {
    if len(text) == 0 || len(text) > 3 {
        return false;
    }
    for var i = 0; i < len(text); i = i + 1 {
        if find("0123456789", text[i]) < 0 {
            return false;
        }
    }
    var number = int(text);
    return number >= 1 && number <= 100;
}

var word = input("Type any word to choose the secret: ");
if word == nil {
    word = "";
}
var secret = pick_secret(word);
print("I'm thinking of a number from 1 to 100.");

var guesses = 0;
while true {
    var line = input("Your guess: ");
    if line == nil {
        print();
        print("Giving up? It was " + secret + ".");
        break;
    }

    var parts = line.split();
    if len(parts) != 1 || !is_guess(parts[0]) {
        print("Please type a whole number from 1 to 100.");
        continue;
    }

    var guess = int(parts[0]);
    guesses = guesses + 1;
    if guess < secret {
        print("Too low.");
    } elif guess > secret {
        print("Too high.");
    } else {
        var noun = "guesses";
        if guesses == 1 {
            noun = "guess";
        }
        print("Got it in", guesses, noun + "!");
        break;
    }
}
