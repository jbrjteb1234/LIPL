// integers stay integers; any float makes the result a float
print(1 + 2 * 3, (1 + 2) * 3, 10 - 4 - 3);
print(7 / 2, -7 / 2, 7 / 2.0, 7.0 / 2);
print(7 % 3, -7 % 3, 7.5 % 2);
print(2 ^ 10, 2 ^ 3 ^ 2, 2 ^ -1, -2 ^ 2);
print(27 _ 3, 16 _ 2, 2 _ 2, -8 _ 3, 10 _ 3);
print(0.1 + 0.2, 1 / 3.0, 2.5 * 4);
print(9223372036854775807, -9223372036854775807 - 1);
