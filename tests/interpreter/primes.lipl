// Sieve of Eratosthenes: every prime below 50
const var limit = 50;

var is_prime = [];
for var i = 0; i < limit; i = i + 1 {
    is_prime.push(i >= 2);
}

for var i = 2; i * i < limit; i = i + 1 {
    if is_prime[i] {
        for var multiple = i * i; multiple < limit; multiple = multiple + i {
            is_prime[multiple] = false;
        }
    }
}

var primes = [];
for var i = 0; i < limit; i = i + 1 {
    if is_prime[i] { primes.push(i); }
}
print(primes);
print(len(primes), "primes below", limit);
